# Full toolchain image (clivern/swarm:<tag>-toolchain). Pi can run go test, cargo, mix, etc.
FROM node:24-bookworm-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY --from=ghcr.io/astral-sh/ruff:latest /ruff /usr/local/bin/ruff

ARG GO_VERSION=1.26.0
ARG TARGETARCH

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/go/bin:/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        build-essential \
        python3 \
        python3-pip \
        python3-venv \
        elixir \
        erlang-dev \
        php-cli \
        php-mbstring \
        php-xml \
        php-curl \
        php-zip \
        ripgrep \
        patch \
        file \
    && rm -rf /var/lib/apt/lists/* \
    && set -eu \
    && arch="${TARGETARCH:-amd64}" \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz" | tar -C /usr/local -xzf - \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain stable --profile default --no-modify-path \
    && curl -fsSL https://getcomposer.org/installer \
        | php -- --install-dir=/usr/local/bin --filename=composer \
    && npm install -g --ignore-scripts @earendil-works/pi-coding-agent

WORKDIR /repo

COPY entrypoint.sh /usr/local/bin/swarm-pi-entrypoint
RUN chmod +x /usr/local/bin/swarm-pi-entrypoint

ENTRYPOINT ["/usr/local/bin/swarm-pi-entrypoint"]
